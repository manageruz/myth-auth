parameters:
	tmpDir: build/phpstan
	level: 5
	paths:
		- src/
		- tests/
	bootstrapFiles:
		- vendor/codeigniter4/framework/system/Test/bootstrap.php
	excludePaths:
		- src/Config/Routes.php
		- src/Views/*
	# Some patterns only match on some PHP versions or tool versions
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		- '#.+deprecated class Myth\\Auth\\Authorization\\(Group|Permission)Model.+#'
		- '#.+Mockery.+#'
		- '#Call to an undefined method .+::shouldReceive\(\)#'
		- '#Call to an undefined static method Config\\Services::[A-Za-z]+\(\)#'
		- '#Cannot access property [\$a-z_]+ on (array|object)#'
		# AuthTrait is public API for applications; the library itself does not use it
		-
			identifier: trait.unused
			path: src/AuthTrait.php
	universalObjectCratesClasses:
		- CodeIgniter\Entity\Entity
		- Faker\Generator
	scanDirectories:
		- vendor/codeigniter4/framework/system/Helpers
	dynamicConstantNames:
		- APP_NAMESPACE
		- CI_DEBUG
		- ENVIRONMENT
